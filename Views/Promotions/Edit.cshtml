@model PromoApp.Models.TblPromotion

@{
    var products = ViewBag.Products as List<PromoApp.Models.TblProduct> ?? new List<PromoApp.Models.TblProduct>();
}

<h2>Редагування акції (Тільки майбутні)</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div style="margin-bottom: 12px;">
        <label>Назва акції:</label><br />
        <input asp-for="Title" required style="width: 100%; padding: 6px;" />
    </div>

    <div style="display: flex; gap: 15px; margin-bottom: 15px;">
        <div style="flex: 1;">
            <label>Дата початку:</label><br />
            <input type="date" asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" required style="width: 100%; padding: 6px;" />
        </div>
        <div style="flex: 1;">
            <label>Дата завершення:</label><br />
            <input type="date" asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" required style="width: 100%; padding: 6px;" />
        </div>
    </div>

    <h4>Товари та знижки</h4>
    <div id="items-box">
        @if (Model.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <div class="item-row" style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <select name="productIds" style="flex: 2; padding: 6px;">
                        @foreach (var prod in products)
                        {
                            <option value="@prod.Id" selected="@(prod.Id == item.ProductId)">
                                @prod.Name (@prod.BasePrice грн)
                            </option>
                        }
                    </select>
                    <input type="number" name="discounts" value="@item.DiscountPercent" min="1" max="100" style="flex: 1; padding: 6px;" />
                </div>
            }
        }
        else
        {
            <div class="item-row" style="display: flex; gap: 10px; margin-bottom: 10px;">
                <select name="productIds" style="flex: 2; padding: 6px;">
                    <option value="0">Оберіть товар...</option>
                    @foreach (var prod in products)
                    {
                        <option value="@prod.Id">@prod.Name (@prod.BasePrice грн)</option>
                    }
                </select>
                <input type="number" name="discounts" placeholder="Знижка %" min="1" max="100" style="flex: 1; padding: 6px;" />
            </div>
        }
    </div>

    <button type="button" class="btn btn-gray" onclick="addRow()">+ Додати ще товар</button>
    <br /><br />
    <button type="submit" class="btn btn-blue">Зберегти зміни</button>
    <a asp-action="Index" class="btn btn-gray">Скасувати</a>
</form>

<script>
    function addRow() {
        var box = document.getElementById('items-box');
        var rows = box.querySelectorAll('.item-row');
        var clone = rows[0].cloneNode(true);
        clone.querySelectorAll('input, select').forEach(i => i.value = (i.tagName === 'SELECT' ? 0 : ''));
        box.appendChild(clone);
    }
</script>